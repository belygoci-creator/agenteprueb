# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Supabase (base de datos + auth) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en servidor, nunca expuesta al cliente
SUPABASE_SERVICE_ROLE_KEY=

# ─── API de Claude (Anthropic) ────────────────────────────────────────────────
# Motor conversacional de la entrevista. Se llama solo desde el servidor.
ANTHROPIC_API_KEY=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Único email autorizado a loguearse (uso interno, un solo asesor -- ver docs/business.md).
ASESOR_EMAIL_PERMITIDO=

# Opcional, solo desarrollo local con `next dev` (no hace falta con `vercel dev`
# ni en producción). Levantar con: python api/_run_local_server.py
# MOTOR_CALCULO_URL=http://localhost:8001

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# supabase usa OAuth vía /mcp, no necesita variable acá.

# ─── Revisión diaria de mercado (supabase/functions/revision-diaria) ──────────
# Esta sección NO se lee desde .env.local: la Edge Function corre en Supabase,
# no en este proyecto Next.js. Se configuran como secrets de Supabase con:
#   supabase secrets set NOMBRE=valor
# Se documentan acá igual, para que quien clone el repo sepa que existen.
#
# CRON_SECRET: valor arbitrario que vos mismo generás (no es la clave de
# ninguna cuenta) -- lo verifica la función en la cabecera "Authorization:
# Bearer <CRON_SECRET>" para confirmar que quien la llama es el cron y no
# cualquiera. pg_cron tiene que mandar ese mismo header.
CRON_SECRET=
#
# Envía el correo de aviso (al asesor siempre, al cliente si avisar_cliente=true)
# a través de Composio, usando la cuenta de Gmail conectada dentro del MISMO
# proyecto de Composio que esta API key -- no es SMTP directo, no hace falta
# contraseña de aplicación de Gmail. IMPORTANTE: la API key debe tener el
# permiso "tool_execution" con acceso de escritura (elegí "Full access" al
# crearla), y Gmail debe estar conectado en Auth Configs de ese mismo proyecto
# -- una cuenta conectada en otro proyecto de Composio no es visible acá.
COMPOSIO_API_KEY=
# GET https://backend.composio.dev/api/v3/connected_accounts (header x-api-key
# con tu COMPOSIO_API_KEY) para obtener estos dos campos de la conexión activa
# de Gmail: "id" (empieza con "ca_") y "user_id".
COMPOSIO_GMAIL_ACCOUNT_ID=
COMPOSIO_GMAIL_ENTITY_ID=
#
# ASESOR_EMAIL_PERMITIDO ya está definido arriba, en "Configuración de la
# app" -- la Edge Function lo reutiliza para avisarle al asesor de cada alerta.
