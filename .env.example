# Copia este archivo como .env.local y rellena los valores reales.
# Nunca comitees .env.local ni ningún archivo con credenciales reales.

# ─── Supabase (base de datos + auth) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo en servidor, nunca expuesta al cliente
SUPABASE_SERVICE_ROLE_KEY=

# ─── API de Claude (Anthropic) ────────────────────────────────────────────────
# Motor conversacional de la entrevista. Se llama solo desde el servidor.
ANTHROPIC_API_KEY=

# ─── Configuración de la app ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opcional, solo desarrollo local con `next dev` (no hace falta con `vercel dev`
# ni en producción). Levantar con: python api/_run_local_server.py
# MOTOR_CALCULO_URL=http://localhost:8001

# ─── MCP (servidores para el agente de código) ────────────────────────────────
# supabase usa OAuth vía /mcp, no necesita variable acá.
